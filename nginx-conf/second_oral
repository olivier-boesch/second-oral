##
# Second Oral — configuration nginx hôte
# Masque la version nginx dans le header Server
server_tokens off;
#
# Le nginx hôte termine le SSL (Certbot) et proxyfie vers le nginx Docker
# qui écoute sur 127.0.0.1:8080.
##

server {
    server_name stex.mesoraux.fr;

    # Page d'erreur maison si le conteneur est arrêté
    root /home/olivier/second_oral/webserver/static;

    location / {
        proxy_pass http://127.0.0.1:8080;

        proxy_set_header Host               $host;
        # $remote_addr uniquement : écrase tout X-Forwarded-For envoyé par le client
        # (évite l'usurpation d'IP). Le nginx Docker passe ce header intact.
        proxy_set_header X-Forwarded-For    $remote_addr;
        proxy_set_header X-Forwarded-Proto  $scheme;
        proxy_set_header X-Forwarded-Host   $host;
        proxy_set_header X-Forwarded-Prefix /;

        proxy_read_timeout  120s;
        proxy_connect_timeout 10s;

        # SSE : désactiver le buffering pour /stream
        proxy_buffering off;
    }

    # Assets statiques directement depuis l'hôte (optionnel, évite le Docker)
    location /static/ {
        alias /home/olivier/second_oral/webserver/static/;
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
    }

    # Pages d'erreur servies depuis l'hôte si Docker est down
    error_page 500 502 503 504 /error.html;
    location = /error.html { }
    location = /main.css   { }
    location = /error_bg.jpg { }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl;                  # managed by Certbot
    ssl_certificate     /etc/letsencrypt/live/stex.mesoraux.fr/fullchain.pem;    # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/stex.mesoraux.fr/privkey.pem;      # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf;                              # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;                               # managed by Certbot
}

server {
    if ($host = stex.mesoraux.fr) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name stex.mesoraux.fr;
    return 404; # managed by Certbot
}
