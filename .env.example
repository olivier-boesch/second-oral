# ── Variables d'environnement pour docker-compose ─────────────────────────────
# Copier ce fichier en .env et remplir les valeurs.
# Les credentials DB DOIVENT correspondre à ceux de webserver/app_secrets.py.

# ── MariaDB ───────────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=changer_ce_mot_de_passe_root
DB_NAME=SecondOral
# Doit correspondre à DB_PARAMS["user"] dans app_secrets.py
DB_USER=secondoral
# Doit correspondre à DB_PARAMS["password"] dans app_secrets.py
DB_PASSWORD=changer_ce_mot_de_passe_db
